---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternDivider from '../../components/shared/PatternDivider.astro';
import PhotoGallery from '../../components/events/PhotoGallery.astro';
import FundingAcknowledgement from '../../components/events/FundingAcknowledgement.astro';
import { findEventImage } from '../../lib/eventAssets';

const slug = 'rehearsal-day-2026';
const eventName = 'Rehearsal Day 2026';
// Accepts poster.* or, if that is what was uploaded, flier.*
const posterSrc = findEventImage(slug, ['poster', 'flier']);
const hasPoster = Boolean(posterSrc);
---

<BaseLayout
  title="Rehearsal Day, 26 September 2026 | T-MAC UK"
  description="Voices together. Culture celebrated. Community connected. Photos from The Midlands African Choir UK Rehearsal Day, Saturday 26 September 2026."
  canonicalPath={`/events/${slug}`}
  ogImage={hasPoster ? `https://www.themidlandsafricanchoir.co.uk${posterSrc}` : undefined}
>

  <!-- Header -->
  <section class="bg-black pt-16 pb-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-gold/60 mb-3">Event Recap</p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-gold leading-tight mb-4">Rehearsal Day</h1>
      <p class="text-cream text-lg mb-2">
        <time datetime="2026-09-26">Saturday 26 September 2026</time>
      </p>
      <p class="font-serif italic text-cream/80 text-xl md:text-2xl">
        &ldquo;Voices together. Culture celebrated. Community connected.&rdquo;
      </p>
    </div>
  </section>

  <PatternDivider />

  <FundingAcknowledgement variant="top" />

  <PatternDivider variant="adinkra" />

  <!-- Text + poster -->
  <section class="bg-black py-16 px-4">
    <div class={`max-w-5xl mx-auto ${hasPoster ? 'md:grid md:grid-cols-3 gap-10 items-start' : ''}`}>
      <div class={hasPoster ? 'md:col-span-2' : 'max-w-3xl mx-auto'}>
        <h2 class="font-serif text-3xl text-gold mb-5">An Afternoon of Music and Community</h2>
        <p class="text-cream/80 text-lg leading-relaxed">
          As we prepare for our upcoming performances, The Midlands African Choir UK came together for an afternoon of music, harmony and community.
        </p>
      </div>

      {hasPoster && (
        <figure class="mt-10 md:mt-0">
          <img
            src={posterSrc}
            alt="Poster for the Midlands African Choir UK Rehearsal Day, 26 September 2026"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-xl border border-gold/30"
          />
          <figcaption class="mt-2 text-center text-cream/50 text-xs">Rehearsal Day poster</figcaption>
        </figure>
      )}
    </div>
  </section>

  <PatternDivider />

  <!-- Gallery -->
  <section class="bg-black py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-serif text-3xl md:text-4xl text-gold mb-10 text-center">Photo Gallery</h2>
      <PhotoGallery slug={slug} eventName={eventName} />
    </div>
  </section>

  <PatternDivider variant="adinkra" />

  <!-- CTA -->
  <section class="bg-black py-16 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-2xl md:text-3xl text-gold mb-4">Come and sing with us</h2>
      <p class="text-cream/70 text-lg mb-8">We welcome singers of all experience levels.</p>
      <a
        href="/join"
        class="inline-flex items-center justify-center bg-gold text-black font-bold px-10 py-4 rounded-md text-lg min-h-[44px] hover:bg-gold/90 transition-colors"
      >
        Come and sing with us
      </a>
    </div>
  </section>

  <FundingAcknowledgement variant="footer" />

</BaseLayout>
